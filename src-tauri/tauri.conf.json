{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sesame",
  "version": "0.1.0",
  "identifier": "com.sesame.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "beforeBundleCommand": "node scripts/generate-file-associations.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sesame",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "visible": false,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app"],
    "publisher": "Sesame contributors",
    "copyright": "Copyright (c) 2026 Sesame contributors",
    "category": "DeveloperTool",
    "shortDescription": "Fast, lightweight text editor and file viewer",
    "longDescription": "Sesame opens instantly and handles the files other editors choke on: huge logs, GBK-encoded configs, and images. Files over 5 MB load in chunks, saves are atomic, and the encoding you opened with is the encoding written back.",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "fragmentPaths": ["gen/file-associations.wxs"],
        "componentRefs": ["SesameFileCandidates"]
      },
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "fileAssociations": [
      {
        "ext": ["png", "jpg", "jpeg", "gif", "webp", "bmp", "ico", "avif"],
        "name": "Image File",
        "description": "Image file",
        "role": "Viewer"
      },
      {
        "ext": ["txt", "log", "ini", "conf", "cfg"],
        "name": "Text File",
        "description": "Plain text file",
        "role": "Editor"
      },
      {
        "ext": ["md", "markdown"],
        "name": "Markdown File",
        "description": "Markdown document",
        "role": "Editor"
      },
      {
        "ext": ["json", "jsonc"],
        "name": "JSON File",
        "description": "JSON data file",
        "role": "Editor"
      },
      {
        "ext": ["js", "mjs", "cjs", "ts", "tsx", "jsx"],
        "name": "JavaScript File",
        "description": "JavaScript source file",
        "role": "Editor"
      },
      {
        "ext": [
          "py", "rs", "go", "java", "c", "h", "cpp", "hpp",
          "css", "html", "xml", "yml", "yaml", "sql", "sh", "toml"
        ],
        "name": "Source Code File",
        "description": "Source code file",
        "role": "Editor"
      }
    ]
  }
}
